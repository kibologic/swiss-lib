{
  "name": "@swissjs/testing",
  "version": "0.1.0",
  "description": "Official component testing library for SwissJS — mounts components via the real runtime and queries the rendered DOM",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsc -b",
    "dev": "pnpm exec tsc -b --watch",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest --watch",
    "type-check": "pnpm exec tsc --noEmit",
    "clean": "rm -rf dist node_modules && rm -f tsconfig.tsbuildinfo",
    "lint": "pnpm exec eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@swissjs/core": "workspace:*"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "18.19.121",
    "jsdom": "^25.0.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "5.8.2",
    "vitest": "^3.2.6"
  },
  "license": "MIT",
  "author": {
    "name": "Themba Mzumara",
    "email": "themba@swissjs.dev",
    "url": "https://github.com/ThembaMzumara"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kibologic/swiss-lib.git"
  },
  "homepage": "https://github.com/ThembaMzumara/SWISS#readme",
  "bugs": {
    "url": "https://github.com/ThembaMzumara/SWISS/issues"
  },
  "keywords": [
    "swissjs",
    "testing",
    "framework"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false
}
