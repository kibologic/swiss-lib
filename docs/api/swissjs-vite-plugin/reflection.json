					"kind": 4096,
					"flags": {},
					"comment": {
						"summary": [
							{
								"kind": "text",
								"text": "Vite plugin for SwissJS .ui/.uix files.\n\nThis is pure delegation to @swissjs/compiler's own UiCompiler.compileAsync(),\nthe same transform swite's dev-engine calls -- no compilation logic lives\nhere. It exists so standalone Vite-based tools (and external adopters who\ndon't use swite) can compile SwissJS source without swite's own dev-server\nmachinery. Alpine product apps stay on swite; this is not a second\ncompilation path for products, it's a foreign-bundler on-ramp.\n\nCSS handling and env-var inlining are intentionally NOT reimplemented\nhere -- those are Vite's own job via its native pipeline, unlike swite's\ndev-engine where they're bespoke dev-server concerns. Import *resolution*\nfor the standard TS-ESM \".js-suffix-means-.ts-file\" convention (used\nthroughout .ui/.uix source in this ecosystem) does need a resolveId hook\nbelow, since Vite's default resolver doesn't handle that convention on\nits own -- this mirrors swite's own resolveExtensionFix, not new logic."
							}
						]
					},
					"sources": [
						{
							"fileName": "index.ts",
							"line": 46,
							"character": 16,
							"url": "https://github.com/kibologic/swiss-lib/blob/bc6e686f3defa761e805c70c62414d1b42ea8509/plugins/vite/src/index.ts#L46"
						}
