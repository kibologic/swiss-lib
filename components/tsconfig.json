{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": false
  },
  "include": ["src/**/*", "dist/**/*.ts"],
  "exclude": ["node_modules"]
}
