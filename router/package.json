{
  "name": "@swissjs/router",
  "version": "1.4.1",
  "description": "Swiss framework routing and SSR",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm exec tsc -b",
    "dev": "pnpm exec tsc -b --watch",
    "test": "pnpm exec vitest",
    "type-check": "pnpm exec tsc -b",
    "lint": "pnpm exec eslint src"
  },
  "keywords": [
    "swiss",
    "router",
    "ssr",
    "ssg"
  ],
  "author": "Themba Mzumara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kibologic/swiss-lib.git"
  },
  "dependencies": {
    "@swissjs/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
