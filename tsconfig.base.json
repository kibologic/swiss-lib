{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "moduleResolution": "node16",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@swissjs/core": [
        "./runtime/src/index.ts",
        "./runtime/dist/index.mjs"
      ],
      "@swissjs/core/*": [
        "./runtime/src/*",
        "./runtime/dist/*"
      ],
      "@swissjs/security": [
        "./security/src/index.ts",
        "./security/dist/index.js"
      ],
      "@swissjs/security/*": [
        "./security/src/*",
        "./security/dist/*"
      ],
      "@swissjs/compiler": [
        "./compiler/src/index.ts",
        "./compiler/dist/index"
      ],
      "@swissjs/compiler/*": [
        "./compiler/src/*",
        "./compiler/dist/*"
      ],
      "@swissjs/shared": [
        "./shared/src/index.ts",
        "./shared/dist/index"
      ],
      "@swissjs/shared/*": [
        "./shared/src/*",
        "./shared/dist/*"
      ],
      "@swissjs/router": [
        "./router/src/index.ts",
        "./router/dist/index"
      ],
      "@swissjs/router/*": [
        "./router/src/*",
        "./router/dist/*"
      ],
      "@swissjs/components": [
        "./components/src/index.ts",
        "./components/dist/index"
      ],
      "@swissjs/components/*": [
        "./components/src/*",
        "./components/dist/*"
      ],
      "@swissjs/cli": [
        "./cli/src/index.ts",
        "./cli/dist/index"
      ],
      "@swissjs/cli/*": [
        "./cli/src/*",
        "./cli/dist/*"
      ],
      "@swissjs/plugin-*": [
        "./plugins/*/src/index.ts",
        "./plugins/*/dist/index"
      ],
      "@swissjs/plugins/*": [
        "./plugins/*/src/index.ts",
        "./plugins/*/dist/index"
      ]
    }
  }
}