{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "moduleResolution": "node16",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@kibologic/core": [
        "./packages/core/src/index.ts",
        "./packages/core/dist/index.mjs"
      ],
      "@kibologic/core/*": [
        "./packages/core/src/*",
        "./packages/core/dist/*"
      ],
      "@kibologic/security": [
        "./packages/security/dist/index.js"
      ],
      "@kibologic/security/*": [
        "./packages/security/dist/*"
      ],
      "@kibologic/compiler": [
        "./packages/compiler/dist/index"
      ],
      "@kibologic/compiler/*": [
        "./packages/compiler/dist/*"
      ],
      "@kibologic/cli": [
        "./packages/cli/dist/index"
      ],
      "@kibologic/cli/*": [
        "./packages/cli/dist/*"
      ],
      "@kibologic/plugin-*": [
        "./packages/plugins/*/dist/index"
      ],
      "@plugins/*": [
        "./packages/plugins/*/dist"
      ]
    }
  }
}