{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Swiss UI",
  "scopeName": "source.swissui",
  "fileTypes": ["ui", "uix"],
  "patterns": [
    { "include": "#import-declaration" },
    { "include": "#line-comment" },
    { "include": "#block-comment" },
    { "include": "#capability-decorator" },
    { "include": "#component-declaration" }
  ],
  "repository": {
    "import-declaration": {
      "name": "meta.import.swissui",
      "begin": "\\b(import)\\b",
      "end": ";",
      "beginCaptures": {
        "1": { "name": "keyword.control.import.swissui" }
      },
      "patterns": [
        { "include": "#string-double" },
        { "include": "#string-single" },
        {
          "match": "\\b(from)\\b",
          "name": "keyword.control.from.swissui"
        },
        {
          "match": "\\b(as)\\b",
          "name": "keyword.control.as.swissui"
        },
        {
          "match": "[A-Za-z_$][\\w$]*",
          "name": "variable.other.swissui"
        }
      ]
    },

    "capability-decorator": {
      "name": "meta.decorator.requires.swissui",
      "begin": "(@requires)\\s*\\(",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "storage.type.capability.decorator.swissui" }
      },
      "patterns": [
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },

    "component-declaration": {
      "name": "meta.component.swissui",
      "begin": "\\b(component)\\s+([A-Z][A-Za-z0-9_]*)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.component.swissui" },
        "2": { "name": "entity.name.type.component.swissui" }
      },
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#state-block" },
        { "include": "#lifecycle-block" },
        { "include": "#effect-block" },
        { "include": "#computed-property" },
        { "include": "#reactive-declaration" },
        { "include": "#props-declaration" },
        { "include": "#method-declaration" },
        { "include": "#ts-expression" }
      ]
    },

    "state-block": {
      "name": "meta.block.state.swissui",
      "begin": "\\b(state)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.state.swissui" }
      },
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#state-variable" },
        { "include": "#ts-expression" }
      ]
    },

    "state-variable": {
      "name": "meta.variable.state.swissui",
      "match": "\\b(let)\\s+([a-z_$][\\w$]*)(?:\\s*:\\s*([^=;,]+?))?\\s*(?==)",
      "captures": {
        "1": { "name": "keyword.operator.declaration.swissui" },
        "2": { "name": "variable.other.readwrite.swissui" },
        "3": { "name": "entity.name.type.annotation.swissui" }
      }
    },

    "lifecycle-block": {
      "name": "meta.block.lifecycle.swissui",
      "begin": "\\b(mount|unmount)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.lifecycle.swissui" }
      },
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#html-template" },
        { "include": "#ts-expression" }
      ]
    },

    "effect-block": {
      "name": "meta.block.effect.swissui",
      "begin": "\\b(effect)\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.control.effect.swissui" }
      },
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#ts-expression" }
      ]
    },

    "computed-property": {
      "name": "meta.computed.swissui",
      "begin": "\\b(computed)\\s+(get)\\s+([a-z_$][\\w$]*)\\s*\\(\\)",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.control.computed.swissui" },
        "2": { "name": "keyword.other.accessor.swissui" },
        "3": { "name": "entity.name.function.accessor.swissui" }
      },
      "patterns": [
        { "include": "#block-body" }
      ]
    },

    "reactive-declaration": {
      "name": "meta.declaration.reactive.swissui",
      "match": "\\b(reactive)\\s+(let)\\s+([a-z_$][\\w$]*)(?:\\s*:\\s*([^=;]+?))?\\s*(?==)",
      "captures": {
        "1": { "name": "keyword.control.reactive.swissui" },
        "2": { "name": "keyword.operator.declaration.swissui" },
        "3": { "name": "variable.other.reactive.swissui" },
        "4": { "name": "entity.name.type.annotation.swissui" }
      }
    },

    "props-declaration": {
      "name": "meta.props.swissui",
      "begin": "\\b(props)\\s*=\\s*\\{",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.props.swissui" }
      },
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#props-entry" },
        { "include": "#ts-expression" }
      ]
    },

    "props-entry": {
      "match": "([a-z_$][\\w$]*)\\s*:\\s*([A-Za-z][\\w$]*)",
      "captures": {
        "1": { "name": "variable.parameter.prop.swissui" },
        "2": { "name": "entity.name.type.prop.swissui" }
      }
    },

    "method-declaration": {
      "name": "meta.method.swissui",
      "begin": "(?:\\b(async)\\s+)?\\b([a-z_$][\\w$]*)\\s*\\(",
      "end": "(?<=\\})",
      "beginCaptures": {
        "1": { "name": "keyword.control.async.swissui" },
        "2": { "name": "entity.name.function.swissui" }
      },
      "patterns": [
        { "include": "#method-params" },
        { "include": "#return-type" },
        { "include": "#block-body" }
      ]
    },

    "method-params": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#ts-expression" }
      ]
    },

    "return-type": {
      "begin": ":\\s*",
      "end": "(?=\\{)",
      "patterns": [
        { "include": "#ts-expression" }
      ]
    },

    "block-body": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "#line-comment" },
        { "include": "#block-comment" },
        { "include": "#html-template" },
        { "include": "#css-template" },
        { "include": "#ts-expression" }
      ]
    },

    "html-template": {
      "name": "meta.embedded.block.html.swissui",
      "begin": "\\b(html)(`)",
      "end": "`",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.template.html.swissui" },
        "2": { "name": "punctuation.definition.string.template.begin.swissui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.swissui" }
      },
      "contentName": "text.html.derivative",
      "patterns": [
        { "include": "#template-directive-if" },
        { "include": "#template-directive-bind" },
        { "include": "#template-interpolation" },
        { "include": "text.html.basic" }
      ]
    },

    "css-template": {
      "name": "meta.embedded.block.css.swissui",
      "begin": "\\b(css)(`)",
      "end": "`",
      "beginCaptures": {
        "1": { "name": "entity.name.tag.template.css.swissui" },
        "2": { "name": "punctuation.definition.string.template.begin.swissui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.swissui" }
      },
      "contentName": "source.css",
      "patterns": [
        { "include": "source.css" }
      ]
    },

    "template-directive-if": {
      "name": "entity.other.attribute-name.directive.if.swissui",
      "match": "\\*if(?==)"
    },

    "template-directive-bind": {
      "name": "entity.other.attribute-name.directive.bind.swissui",
      "match": "v-bind(?==)"
    },

    "template-interpolation": {
      "name": "meta.template.expression.swissui",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.template-expression.begin.swissui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.template-expression.end.swissui" }
      },
      "patterns": [
        { "include": "source.ts" }
      ]
    },

    "ts-expression": {
      "patterns": [
        { "include": "source.ts" }
      ]
    },

    "line-comment": {
      "name": "comment.line.double-slash.swissui",
      "match": "//.*$"
    },

    "block-comment": {
      "name": "comment.block.swissui",
      "begin": "/\\*",
      "end": "\\*/"
    },

    "string-double": {
      "name": "string.quoted.double.swissui",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.swissui",
          "match": "\\\\."
        }
      ]
    },

    "string-single": {
      "name": "string.quoted.single.swissui",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.swissui",
          "match": "\\\\."
        }
      ]
    }
  }
}
